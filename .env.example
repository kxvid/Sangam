# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Anthropic (Claude API for ranking + message generation)
ANTHROPIC_API_KEY=

# Property data
RENTCAST_API_KEY=
PROPERTYRADAR_API_KEY=

# Skip tracing
BATCHSKIPTRACE_API_KEY=

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=outreach@kahlastudio.com
RESEND_WEBHOOK_SECRET=

# Clerk (web dashboard auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Allowlist (comma-separated emails) — only these emails can sign in
CLERK_ALLOWED_EMAILS=

# Cron secret (Vercel Cron auth — generate any long random string)
CRON_SECRET=

# App
NODE_ENV=development
