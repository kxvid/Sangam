# Server only. Use a separate Supabase project for test/preview and production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (workspace membership, not an email allowlist, authorizes data access).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Server-only comma-separated exact origins; no trailing slash, path or wildcard.
# Local HTTP loopback is accepted only by `npm run dev` (NODE_ENV=development).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Production: CLERK_AUTHORIZED_PARTIES=https://sangam.kahlalabs.com
# Preview: explicitly list only the intended HTTPS preview origin(s).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/acquisition
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/acquisition
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# No provider keys are needed or accepted to enable automatic sending/discovery.
# PG_TEST_URL is only for a dedicated disposable test database, never production.
# PG_TEST_URL=postgresql://postgres:postgres@127.0.0.1:5432/sangam_test_ci
