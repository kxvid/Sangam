{
  "name": "kahla-buyer-network",
  "version": "0.1.0",
  "private": true,
  "description": "KAHLA STUDIO Cash Buyer Network — scored buyer DB + matchmaking for CA wholesalers.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "score-deal": "tsx src/jobs/score-deal.ts",
    "discovery": "tsx src/jobs/nightly-discovery.ts",
    "match": "tsx src/jobs/match-buyers.ts",
    "outreach": "tsx src/jobs/send-outreach.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "node --import tsx --test tests/acquisition.test.ts tests/http.test.ts tests/side-effects.test.ts tests/capacity.test.ts",
    "test:db": "node scripts/test-database.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "node --import tsx scripts/test-browser.mjs",
    "test:production": "node scripts/test-production-smoke.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.22",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "dotenv": "16.6.1",
    "lucide-react": "0.460.0",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "postcss": "8.5.23",
    "supabase": "2.122.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "playwright": "1.60.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
